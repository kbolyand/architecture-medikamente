@startuml
title Data Flow: Оплата медицинских услуг
usecase "Оплата медицинских услуг" as Process
rectangle "Пациент" as Patient
rectangle "Кассир" as Cashier
rectangle "ККМ" as KKM
rectangle "1C Бухгалтерия предприятия\n(шифрование)" as OneC
database "Файловый сервер с учетом платежей\nBuh/Payments.xlsx(шифрование)" as PaymentsFile
database "Журнал аудита" as AuditBook
database "Active Directory" as AD
Patient --> Cashier : Деньги / сведения об услуге
Cashier --> Process : Регистрация оплаты
Process --> KKM : Команда на расчёт
KKM --> OneC : Сведения о принятии средств (TCP/IP + OLE + TLS)
Process --> PaymentsFile : Данные пациента, услуга, сумма, дата
Cashier --> OneC : Учёт / проверка платежа(RBAC)
PaymentsFile --> AuditBook : Запись в аудит о доступе и внесении изменений
PaymentsFile --> AD : Проверка прав доступа на чтение и запись
@enduml
