@startuml
title "Data Flow: Запись пациента к специалисту"
usecase "Запись пациента к специалисту" as Process
rectangle "Пациент" as Patient
rectangle "Администратор ресепшен" as ReceptionAdmin
rectangle "Врач" as Doctor
database "Файловый сервер с данными пациентов и информацией о приемах \n(шифрование)" as PatientBook
database "Журнал аудита" as AuditBook
database "Active Directory" as AD
Patient --> ReceptionAdmin : Данные пациента, желаемый врач и время
ReceptionAdmin --> Process : Регистрация записи
PatientBook --> Process : Идентификация пациента
Process --> PatientBook : ФИО / идентификатор, врач, дата и время
PatientBook --> Doctor : Список записанных пациентов
Doctor --> PatientBook : Просмотр и редактирование журнала
PatientBook --> AuditBook : Запись в аудит о доступе и внесении изменений
PatientBook --> AD : Проверка прав доступа на чтение и запись
@enduml
