@startuml
title "Data Flow: Регистрация пациента"
usecase "Регистрация пациента" as Process
rectangle "Пациент" as Patient
rectangle "Администратор ресепшен" as ReceptionAdmin
database "Patients.xlsx \nExcel-файл со списком пациентов" as PatientBook
database "Pacients/Pacient1-FIO-BD \nФайлы пациента в разных форматах" as PatientFiles
Patient --> ReceptionAdmin : ФИО, дата рождения, телефон, e-mail, анкета
ReceptionAdmin --> Process : Ввод данных
Process --> PatientBook : ПДн пациента
Process --> PatientFiles : Анкета и файлы пациента
@enduml
