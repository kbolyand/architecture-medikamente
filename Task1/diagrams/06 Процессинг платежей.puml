@startuml
title Data Flow: Процессинг платежей
usecase "Процессинг платежей" as Process
rectangle "Бухгалтер" as BookKeeper 
rectangle "1C Бухгалтерия предприятия" as OneC
rectangle "ККМ" as KKM
BookKeeper  --> Process : Ввод и обработка сведений
KKM --> OneC : Сведения о платежах
Process --> OneC : Кадровый учёт, зарплата, налоги, платежи
OneC --> BookKeeper  : Отчётность и расчётные данные
@enduml
