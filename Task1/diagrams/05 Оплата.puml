@startuml
title Data Flow: Оплата медицинских услуг
usecase "Оплата медицинских услуг" as Process
rectangle "Пациент" as Patient
rectangle "Кассир" as Cashier
rectangle "ККМ" as KKM
rectangle "1C Бухгалтерия предприятия" as OneC
database "Buh/Payments.xlsx - учёт платежей" as PaymentsFile
Patient --> Cashier : Деньги / сведения об услуге
Cashier --> Process : Регистрация оплаты
Process --> KKM : Команда на расчёт
KKM --> OneC : Сведения о принятии средств (TCP/IP + OLE)
Process --> PaymentsFile : Данные пациента, услуга, сумма, дата
Cashier --> OneC : Учёт / проверка платежа
@enduml
